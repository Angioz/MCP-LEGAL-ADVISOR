{
  "name": "legal-knowledge-mcp",
  "version": "1.1.0",
  "description": "MCP server providing AI access to legal knowledge from 8 jurisdictions (EU, Italy, Greece, UK, France, Germany, Spain, Paraguay) via 16 legal data tools",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "legal-knowledge-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "sanitize": "node scripts/sanitize.js",
    "prepublishOnly": "npm run sanitize && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "legal",
    "legal-tech",
    "regulatory",
    "compliance",
    "eu-law",
    "eurlex",
    "italian-law",
    "normattiva",
    "inps",
    "agenzia-entrate",
    "greek-tax",
    "aade",
    "uk-legislation",
    "legifrance",
    "boe",
    "paraguay",
    "dnit",
    "silpy",
    "territorial-tax"
  ],
  "author": "Angioz <angioz@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angioz/MCP-LEGAL-ADVISOR.git"
  },
  "homepage": "https://github.com/Angioz/MCP-LEGAL-ADVISOR#readme",
  "bugs": {
    "url": "https://github.com/Angioz/MCP-LEGAL-ADVISOR/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cheerio": "^1.1.2",
    "pdf-parse": "^1.1.1",
    "playwright-core": "^1.57.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.10.0",
    "@types/pdf-parse": "^1.1.5",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
